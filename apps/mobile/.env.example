# Copy to .env for local development. All EXPO_PUBLIC_* values are PUBLIC (bundled into the app): never put a secret here.
# dev | staging | production. Pro tokens from another environment's API are refused.
EXPO_PUBLIC_ENV=dev
# Worker that verifies purchases (apps/api). Emulator → host machine: http://10.0.2.2:8787
EXPO_PUBLIC_API_BASE=http://10.0.2.2:8787
# Ed25519 public key (raw, base64url) matching the Worker's LICENCE_SIGNING_KEY. `npm run licence:keys` prints both.
EXPO_PUBLIC_LICENCE_PUBLIC_KEY=
# AdMob banner unit id. Empty = Google's test banner. Real ids only in release builds.
EXPO_PUBLIC_ADMOB_BANNER_ID=
# Build-time only (read by app.config.ts, not bundled): AdMob app id and EAS project.
ADMOB_ANDROID_APP_ID=
EAS_PROJECT_ID=
