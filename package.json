{
  "name": "finealth",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "build": "turbo run build",
    "check": "turbo run lint typecheck test build",
    "dev:web": "npm run dev --workspace @finealth/web",
    "dev:mobile": "npm run dev --workspace @finealth/mobile",
    "dev:api": "npm run dev --workspace @finealth/api",
    "security": "gitleaks detect --redact && npx --yes osv-scanner scan source -r .",
    "test:web": "playwright test -c tests/web/playwright.config.ts",
    "lint:agents": "node tests/tools/lint-agents.mjs",
    "test:guards": "node --test tests/tools/*.test.mjs",
    "check:secrets": "node tests/tools/check-forbidden-files.mjs",
    "prepare": "node tests/tools/install-githooks.mjs",
    "licence:keys": "node scripts/gen-licence-keys.mjs",
    "cases": "node scripts/test-cases.mjs && python tests/tools/export_cases.py --check",
    "docs": "node scripts/docs-export.mjs docs/HLD.md docs/LLD.md docs/USER_MANUAL.md",
    "licence:test": "node scripts/make-test-licence.mjs",
    "robot": "python tests/automation/run.py --env local --serve",
    "robot:pro-site": "node tests/automation/tools/build-pro-site.mjs",
    "robot:dryrun": "python tests/automation/run.py --dryrun --no-open",
    "docs:shots": "node scripts/manual-screenshots.mjs"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "^12.2.0",
    "@playwright/test": "1.65.0",
    "axe-core": "4.14.0",
    "docx": "^9.15.3",
    "exceljs": "^4.4.0",
    "marked": "^18.1.3",
    "sharp": "^0.35.5",
    "turbo": "2.11.10"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@zenuml/core": {
      "playwright-core": "1.64.1"
    },
    "exceljs": {
      "uuid": "^11.1.1"
    },
    "glob@>=13 <14": "^14.0.2",
    "minimatch@>=10 <11": "^11.0.1"
  },
  "packageManager": "npm@10.9.0"
}
